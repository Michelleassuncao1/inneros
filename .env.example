# Copier ce fichier en .env.local et renseigner les valeurs. Ne jamais publier .env.local.
# Production (OVH) : utilisateur inneros_app (lecture et écriture), avec ?sslmode=require
DATABASE_URL=
# Production : utilisateur propriétaire des tables, pour les migrations et les sauvegardes uniquement
DATABASE_MIGRATION_URL=
# Certificat de l'autorité d'OVH (.pem, en clair ou en base64) : vérifie le certificat du serveur
DATABASE_CA_CERT=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_DRAFTING_ENABLED=true
BREVO_API_KEY=
EMAIL_FROM=
AUTH_SECRET=
TOTP_ENCRYPTION_KEY=
APP_URL=http://localhost:3000
GROUP_MIN_SIZE=10
RAW_RESPONSES_RETENTION_MONTHS=12
RAW_RESPONSES_FALLBACK_MONTHS=18
AUDIT_LOG_RETENTION_MONTHS=24
WORKSHOP_REGISTRATIONS_RETENTION_DAYS=30
WORKSHOP_FEEDBACK_RETENTION_MONTHS=24
# Aide à la rédaction (module D2) : coupée tant que le DPA d'Anthropic n'est pas signé ; Brésil : après les clauses ANPD
AI_WRITING_AID_ENABLED=false
AI_WRITING_AID_BRAZIL=false
CRON_SECRET=
# Sauvegardes chiffrées (npm run sauvegarde:cle) et dossier bin de PostgreSQL (pg_dump, pg_restore)
SAUVEGARDE_CLE=
PG_BIN=
